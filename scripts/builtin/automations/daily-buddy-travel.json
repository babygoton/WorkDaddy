{
  "schemaVersion": 1,
  "id": "daily-buddy-travel",
  "name": "派猫猫旅行（自动派发与领取奖励）",
  "description": "使用各账号 token 处理成长中心的派猫猫旅行：未出发就派发，已到达就领取奖励，不切换当前账号。每 15 分钟检查一轮，派发失败 30 分钟后重试；今日已派或已领取的账号不再重复请求。",
  "enabled": false,
  "trigger": {
    "type": "clientLoaded",
    "types": [
      "clientLoaded",
      "panelOpened"
    ],
    "oncePerNavigation": true
  },
  "schedule": {
    "type": "interval",
    "minutes": 15
  },
  "variables": {},
  "steps": [
    {
      "op": "account.forEach",
      "accounts": "all",
      "switch": false,
      "steps": [
        {
          "op": "logic.catch",
          "steps": [
            {
              "op": "account.travel",
              "mode": "auto",
              "saveAs": "travel"
            },
            {
              "op": "logic.delay",
              "ms": 250
            }
          ],
          "onError": []
        }
      ]
    }
  ],
  "onSuccess": [],
  "onFailure": []
}
